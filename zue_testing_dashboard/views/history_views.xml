<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zue_testing_dashboard_run_view_list" model="ir.ui.view">
        <field name="name">zue.testing.dashboard.run.list</field>
        <field name="model">zue.testing.dashboard.run</field>
        <field name="arch" type="xml">
            <list string="Historial de pruebas" create="0" edit="0" delete="0"
                  class="o_zue_testing_dashboard_history">
                <field name="started_at"/>
                <field name="user_id"/>
                <field name="module_name"/>
                <field name="provider_name"/>
                <field name="scope_label"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-danger="state == 'error'"
                       decoration-warning="state == 'partial'"/>
                <field name="ok_count"/>
                <field name="controlled_count"/>
                <field name="failed_count"/>
                <field name="skipped_count"/>
                <field name="total_count"/>
            </list>
        </field>
    </record>

    <record id="zue_testing_dashboard_run_view_form" model="ir.ui.view">
        <field name="name">zue.testing.dashboard.run.form</field>
        <field name="model">zue.testing.dashboard.run</field>
        <field name="arch" type="xml">
            <form string="Ejecucion de pruebas" create="0" edit="0" delete="0"
                  class="o_zue_testing_dashboard_history">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'success'"
                                   decoration-danger="state == 'error'"
                                   decoration-warning="state == 'partial'"/>
                        </group>
                        <group>
                            <field name="module_name"/>
                            <field name="provider_name"/>
                            <field name="scope_label"/>
                            <field name="suite_scope"/>
                        </group>
                    </group>
                    <group string="Totales">
                        <field name="total_count"/>
                        <field name="ok_count"/>
                        <field name="controlled_count"/>
                        <field name="failed_count"/>
                        <field name="skipped_count"/>
                    </group>
                    <notebook>
                        <page string="Resultados">
                            <field name="line_ids" nolabel="1">
                                <list create="0" edit="0" delete="0"
                                      class="o_zue_testing_dashboard_history">
                                    <field name="sequence"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'ok'"
                                           decoration-info="status == 'controlled'"
                                           decoration-danger="status == 'failed'"
                                           decoration-muted="status == 'skipped'"/>
                                    <field name="module_name"/>
                                    <field name="summary"/>
                                    <field name="test_type" widget="badge"
                                           decoration-info="test_type == 'parametric'"
                                           decoration-primary="test_type == 'process'"/>
                                    <field name="message"/>
                                    <field name="duration"/>
                                </list>
                                <form create="0" edit="0" delete="0"
                                      class="o_zue_testing_dashboard_history o_zue_testing_dashboard_history_line">
                                    <group>
                                        <group>
                                            <field name="status" widget="badge"
                                                   decoration-success="status == 'ok'"
                                                   decoration-info="status == 'controlled'"
                                                   decoration-danger="status == 'failed'"
                                                   decoration-muted="status == 'skipped'"/>
                                            <field name="summary"/>
                                            <field name="test_type" widget="badge"
                                                   decoration-info="test_type == 'parametric'"
                                                   decoration-primary="test_type == 'process'"/>
                                            <field name="module_name"/>
                                        </group>
                                        <group>
                                            <field name="technical_name"/>
                                            <field name="message"/>
                                            <field name="duration"/>
                                        </group>
                                    </group>
                                    <separator string="Datos de prueba" invisible="not test_data"/>
                                    <field name="test_data" nolabel="1"
                                           class="o_zue_testing_dashboard_history_text"
                                           invisible="not test_data"/>
                                    <separator string="Log funcional" invisible="not functional_log"/>
                                    <field name="functional_log" nolabel="1"
                                           class="o_zue_testing_dashboard_history_text"
                                           invisible="not functional_log"/>
                                    <separator string="Detalle" invisible="not detail"/>
                                    <field name="detail" nolabel="1"
                                           class="o_zue_testing_dashboard_history_text"
                                           invisible="not detail"/>
                                    <separator string="Resultado de la prueba" invisible="not result_payload"/>
                                    <field name="result_payload" nolabel="1"
                                           widget="zue_testing_history_result"
                                           invisible="not result_payload"/>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="zue_testing_dashboard_run_view_search" model="ir.ui.view">
        <field name="name">zue.testing.dashboard.run.search</field>
        <field name="model">zue.testing.dashboard.run</field>
        <field name="arch" type="xml">
            <search string="Historial de pruebas">
                <field name="name"/>
                <field name="user_id"/>
                <field name="module_name"/>
                <field name="provider_name"/>
                <field name="test_catalog" string="Prueba"/>
                <field name="started_at"/>
                <filter string="Mis ejecuciones" name="filter_my_runs" domain="[('user_id', '=', uid)]"/>
                <filter string="Con fallos" name="filter_failed_runs" domain="[('failed_count', '>', 0)]"/>
                <group>
                    <filter string="Usuario" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Modulo" name="group_module" context="{'group_by': 'module_name'}"/>
                    <filter string="Grupo" name="group_provider" context="{'group_by': 'provider_name'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by': 'started_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="zue_testing_dashboard_run_action" model="ir.actions.act_window">
        <field name="name">Historial</field>
        <field name="res_model">zue.testing.dashboard.run</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="zue_testing_dashboard_run_view_search"/>
    </record>

    <menuitem id="zue_testing_dashboard_menu_history"
        name="Historial"
        parent="zue_testing_dashboard.zue_testing_dashboard_menu_root"
        action="zue_testing_dashboard.zue_testing_dashboard_run_action"
        sequence="20"
        groups="zue_testing_dashboard.zue_testing_dashboard_group_user"/>
</odoo>
