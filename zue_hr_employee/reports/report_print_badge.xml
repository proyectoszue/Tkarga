<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_print_badge_paperformat" model="report.paperformat">
        <field name="name">Formato Carnet Vertical</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">86</field>
        <field name="page_width">55</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="hr_employee_print_badge_paperformat_horizontal" model="report.paperformat">
        <field name="name">Formato Carnet Horizontal</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">70</field>
        <field name="page_width">108</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="hr.hr_employee_print_badge" model="ir.actions.report">
        <field name="paperformat_id" ref="hr_employee_print_badge_paperformat"/>
    </record>
</odoo>
